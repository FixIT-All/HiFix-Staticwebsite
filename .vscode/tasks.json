{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Production build check",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false
		},
		{
			"label": "Check local deploy auth and state",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"git status --short --branch && gh auth status"
			],
			"isBackground": false
		}
	]
}